{
  "name": "typesafe-openai-proxy",
  "version": "0.1.18",
  "private": true,
  "description": "An OpenAI-compatible proxy that gives hass_local_openai_llm a typed, calibrated fast path: one System One decision call per command instead of an LLM turn.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/build-ui.mjs && tsx watch src/server.ts",
    "dev:ui": "node scripts/build-ui.mjs --watch",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "tsc && npm run build:ui",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
