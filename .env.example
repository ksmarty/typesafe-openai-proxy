# Everything here is optional — the dashboard writes data/config.json and that is
# enough for a working install. Environment variables win over the file when set.

# Host directory docker-compose.yml bind-mounts to /app/data (real drive path).
# Examples: /opt/typesafe-proxy, /mnt/user/appdata/typesafe-proxy, /srv/docker/typesafe-proxy
TYPESAFE_DATA_PATH=/opt/typesafe-proxy

# Only used by docker-compose.traefik.yml: the hostname Traefik serves, and the
# bearer token Home Assistant sends (leave empty to accept any client).
PROXY_HOST=proxy.example.com
TYPESAFE_PROXY_KEY=

PORT=8080
HOST=0.0.0.0

# Bearer token hass_local_openai_llm sends to the proxy. Leave empty to accept anything.
PROXY_API_KEY=

# The inference server the proxy hands anything it will not decide itself.
UPSTREAM_BASE_URL=http://localhost:8081/v1
UPSTREAM_API_KEY=
# Reuse SYSTEMONE_API_KEY for forwarded requests when the key above is empty — one
# OpenRouter key for both the decision model and the fallback (1/true/yes/on).
UPSTREAM_API_KEY_FROM_DECISION=

# The typed decision model. There is no default: until you set DECISION_BACKEND and a
# URL, the proxy decides nothing and forwards every request unchanged.
#   systemone  — a typed decision model (local Ollama >= 0.35 serving jev, or hosted)
#   heuristic  — the built-in offline matcher, for trying the routing out
#   none       — forward everything (the default)
DECISION_BACKEND=none
SYSTEMONE_BASE_URL=
SYSTEMONE_API_KEY=
SYSTEMONE_MODEL=

# Used only to read the entity catalog over the websocket. Without it the catalog is
# parsed out of the system prompt Home Assistant sends with every request.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Off by default: the fast path only runs for a request that asks for it by naming the
# model "typesafe-router". Set this to 1 to let the configured backend decide everything.
AUTO_START=

# The clock "what time is it?" is answered from, as an IANA zone (Europe/Amsterdam).
# Leave empty and the time Home Assistant reported in the request's system prompt is used,
# which is already the home's own timezone; with no prompt clock either, the container's.
CLOCK_TIMEZONE=

# The weather. Questions about the weather are answered by Pirate Weather's own written
# summaries, in the language and units of the request. Empty key = the feature is off and
# every weather question is forwarded to your model as before. With no coordinates given,
# Home Assistant's zone.home is used, so they only have to be set if HA is not configured.
WEATHER_API_KEY=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# si | ca | uk | us, or empty to follow the locale Home Assistant sends.
WEATHER_UNITS=
WEATHER_LANGUAGE=
# The summary, then the temperature (`current`), the summary alone (`summary`), the summary
# with the day's high and low (`full`), the temperature first (`temperature_first`), or the
# same forecast said the way a person would, varying the phrasing (`natural`).
WEATHER_STYLE=
WEATHER_BASE_URL=

# Music. "Play Taylor Swift" is played in the room the sentence was spoken to, as the artist's
# top tracks; "play Don't Tap The Glass by Tyler The Creator" plays the album. Music Assistant's
# own service is used when Home Assistant offers it, because it searches every provider at once;
# then a script of yours that takes a media id and type (a "Play Music" script is what plays when
# the generic service will not); then the player's own play_media; Home Assistant's media search
# last. MUSIC=0 hands music back to your model.
MUSIC=
# auto | music_assistant | script | assist
MUSIC_PROVIDER=
# replace | play | next | replace_next | add — what happens to the queue.
MUSIC_ENQUEUE=
# artist | radio — what a bare artist name plays.
MUSIC_ARTIST=

# Media commands. "pause", "stop the music", "volume up", "next song" and "turn the TV off"
# become Home Assistant's own media intents against the player that is playing, or the one in the
# room the sentence names — no model call. Volume moves by a relative step, a bare "pause" needs
# something playing, and two equally plausible players is forwarded rather than guessed. MEDIA=0
# hands all of it back to your model.
MEDIA=

# Judge whether a sentence was aimed at the assistant before forwarding it, and answer the
# overheard ones with the silence message instead. On by default; LISTENING=0 restores plain
# pass-through. LISTENING_LOCAL=0 keeps the model's judgement but drops the local reader.
LISTENING=
LISTENING_LOCAL=
LISTENING_CONFIDENCE=
