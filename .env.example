# Everything here is optional — the dashboard writes data/config.json and that is
# enough for a working install. Environment variables win over the file when set.

# Host directory docker-compose.yml bind-mounts to /app/data (real drive path).
# Examples: /opt/typesafe-proxy, /mnt/user/appdata/typesafe-proxy, /srv/docker/typesafe-proxy
TYPESAFE_DATA_PATH=/opt/typesafe-proxy

# Only used by docker-compose.traefik.yml: the hostname Traefik serves, and the
# bearer token Home Assistant sends (leave empty to accept any client).
PROXY_HOST=proxy.example.com
TYPESAFE_PROXY_KEY=

PORT=8080
HOST=0.0.0.0

# Bearer token hass_local_openai_llm sends to the proxy. Leave empty to accept anything.
PROXY_API_KEY=

# The inference server the proxy hands anything it will not decide itself.
UPSTREAM_BASE_URL=http://localhost:8081/v1
UPSTREAM_API_KEY=
# Reuse SYSTEMONE_API_KEY for forwarded requests when the key above is empty — one
# OpenRouter key for both the decision model and the fallback (1/true/yes/on).
UPSTREAM_API_KEY_FROM_DECISION=

# The typed decision model. There is no default: until you set DECISION_BACKEND and a
# URL, the proxy decides nothing and forwards every request unchanged.
#   systemone  — a typed decision model (local Ollama >= 0.35 serving jev, or hosted)
#   heuristic  — the built-in offline matcher, for trying the routing out
#   none       — forward everything (the default)
DECISION_BACKEND=none
SYSTEMONE_BASE_URL=
SYSTEMONE_API_KEY=
SYSTEMONE_MODEL=

# Used only to read the entity catalog over the websocket. Without it the catalog is
# parsed out of the system prompt Home Assistant sends with every request.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Off by default: the fast path only runs for a request that asks for it by naming the
# model "typesafe-router". Set this to 1 to let the configured backend decide everything.
AUTO_START=
